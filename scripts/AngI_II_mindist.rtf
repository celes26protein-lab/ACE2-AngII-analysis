import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from scipy.stats import ttest_ind
from scipy.stats import f

# -----------------------------
# XVG reader
# -----------------------------
def read_xvg(filename):

    x = []
    y = []

    with open(filename) as fh:
        for line in fh:

            if line.startswith("@") or line.startswith("#"):
                continue

            cols = line.split()

            x.append(float(cols[0]))
            y.append(float(cols[1]))

    return pd.DataFrame({
        "time_ps": x,
        "distance_nm": y
    })


# -----------------------------
# Load data
# -----------------------------
angI = read_xvg("mindist_AngI.xvg")
angII = read_xvg("mindist_AngII.xvg")

# nm → Å
d1 = angI["distance_nm"] * 10
d2 = angII["distance_nm"] * 10


# -----------------------------
# Contact occupancy
# cutoff = 4 Å
# -----------------------------
cutoff = 4.0

occ1 = (d1 < cutoff).mean() * 100
occ2 = (d2 < cutoff).mean() * 100


# -----------------------------
# Statistics
# -----------------------------
mean1 = d1.mean()
std1 = d1.std()

mean2 = d2.mean()
std2 = d2.std()

# Welch t-test
t_stat, p_value = ttest_ind(
    d1,
    d2,
    equal_var=False
)

# F-test
var1 = np.var(d1, ddof=1)
var2 = np.var(d2, ddof=1)

if var1 > var2:
    F_value = var1 / var2
    df1 = len(d1) - 1
    df2 = len(d2) - 1
else:
    F_value = var2 / var1
    df1 = len(d2) - 1
    df2 = len(d1) - 1

p_f = 2 * min(
    f.cdf(F_value, df1, df2),
    1 - f.cdf(F_value, df1, df2)
)


# -----------------------------
# Print results
# -----------------------------
print("\n===== Active-site distance analysis =====\n")

print(
    f"AngI mean = {mean1:.2f} Å"
)
print(
    f"AngI SD   = {std1:.2f} Å"
)
print(
    f"AngI contact occupancy (<{cutoff} Å) = {occ1:.1f}%\n"
)

print(
    f"AngII mean = {mean2:.2f} Å"
)
print(
    f"AngII SD   = {std2:.2f} Å"
)
print(
    f"AngII contact occupancy (<{cutoff} Å) = {occ2:.1f}%\n"
)

print(
    f"t-statistic = {t_stat:.4f}"
)
print(
    f"p-value     = {p_value:.4e}\n"
)

print(
    f"F-value     = {F_value:.4f}"
)
print(
    f"F-test p    = {p_f:.4e}"
)


# -----------------------------
# Histogram
# -----------------------------
plt.figure(figsize=(8,6))

plt.hist(
    d1,
    bins=50,
    alpha=0.6,
    label=f"AngI (occ={occ1:.1f}%)",
    density=True
)

plt.hist(
    d2,
    bins=50,
    alpha=0.6,
    label=f"AngII (occ={occ2:.1f}%)",
    density=True
)

plt.axvline(
    cutoff,
    linestyle="--",
    linewidth=2,
    label="4 Å cutoff"
)

text = (
    f"AngI = {mean1:.2f} ± {std1:.2f} Å\n"
    f"AngII = {mean2:.2f} ± {std2:.2f} Å\n"
    f"p = {p_value:.3e}\n"
    f"F = {F_value:.2f}"
)

plt.text(
    0.98,
    0.98,
    text,
    transform=plt.gca().transAxes,
    ha="right",
    va="top",
    bbox=dict(facecolor="white")
)

plt.xlabel("Active-site distance (Å)")
plt.ylabel("Probability density")

plt.legend()

plt.tight_layout()

plt.show()
