import matplotlib.pyplot as plt
import numpy as np

clusters = ['Cluster 1\n(Top)', 'Cluster 2', 'Cluster 3']
subtypeA_scores = [-127.8, -121.6, -109.8]
subtypeA_sd = [13.1, 20.1, 13.9]
subtypeB_scores = [-133.4, -131.9, -113.0]
subtypeB_sd = [3.7, 3.4, 20.6]

x = np.arange(len(clusters))
width = 0.35

fig, ax = plt.subplots(figsize=(6, 5))

bars_a = ax.bar(x - width/2, subtypeA_scores, width, yerr=subtypeA_sd,
                 label='Subtype A', color='white', edgecolor='black',
                 linewidth=1.2, capsize=4,
                 error_kw={'ecolor': 'black', 'elinewidth': 1.2})

bars_b = ax.bar(x + width/2, subtypeB_scores, width, yerr=subtypeB_sd,
                 label='Subtype B', color='black', edgecolor='black',
                 linewidth=1.2, capsize=4,
                 error_kw={'ecolor': 'black', 'elinewidth': 1.2})

ax.set_ylabel('HADDOCK score', fontsize=12)
ax.set_xticks(x)
ax.set_xticklabels(clusters, fontsize=11)
ax.axhline(0, color='black', linewidth=0.8)

ax.legend(frameon=False, fontsize=11, loc='upper center',
          bbox_to_anchor=(0.5, -0.15), ncol=2)

ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)

ax.set_ylim(top=10)

plt.tight_layout()
plt.savefig('haddock_score_bw.png', dpi=300, bbox_inches='tight')
plt.show()
